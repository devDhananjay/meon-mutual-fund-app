# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Keep iOS aligned with Android (`android/gradle.properties` newArchEnabled=false).
# New Architecture on iOS only can trigger a race where native emits events before
# `RCTEventEmitter` is registered (red screen: receiveEvent / registerCallableModule).
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MeonMutualFunds' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => false
  )

  target 'MeonMutualFundsTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Align pod deployment targets with the app (avoids Xcode SDK warnings, e.g. pods still on iOS 9).
    app_ios = '15.1'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        current = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if current.nil? || current.to_s.include?('$')

        begin
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_ios if Gem::Version.new(current) < Gem::Version.new(app_ios)
        rescue ArgumentError
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_ios
        end
      end
    end
  end
end
