# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Keep iOS aligned with Android (`android/gradle.properties` newArchEnabled=false).
# New Architecture on iOS only can trigger a race where native emits events before
# `RCTEventEmitter` is registered (red screen: receiveEvent / registerCallableModule).
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MeonMutualFunds' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => false
  )

  target 'MeonMutualFundsTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Align pod deployment targets with the app (avoids Xcode SDK warnings, e.g. pods still on iOS 9).
    app_ios = '15.1'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        current = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if current.nil? || current.to_s.include?('$')

        begin
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_ios if Gem::Version.new(current) < Gem::Version.new(app_ios)
        rescue ArgumentError
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_ios
        end
      end
    end

    # Xcode 26 / Apple Clang: fmt 11.0.2 FMT_STRING consteval fails.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |cfg|
        cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end

    %w[fmt.debug.xcconfig fmt.release.xcconfig].each do |name|
      xc = File.join(installer.sandbox.root, 'Target Support Files', 'fmt', name)
      next unless File.exist?(xc)
      xc_content = File.read(xc)
      File.write(xc, xc_content.gsub('CLANG_CXX_LANGUAGE_STANDARD = c++20', 'CLANG_CXX_LANGUAGE_STANDARD = c++17'))
    end

    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      File.chmod(0644, fmt_base)

      unless content.include?('Xcode 26 workaround')
        content = content.gsub(
          "#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 1",
          "// Xcode 26 workaround: Apple Clang consteval is stricter than fmt 11.0.2 expects\n#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 0",
        )
      end

      unless content.include?('XCODE26_FMT_FORCE_NO_CONSTEVAL')
        content = content.sub(
          "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval\n#  define FMT_CONSTEXPR20 constexpr\n#else\n#  define FMT_CONSTEVAL\n#  define FMT_CONSTEXPR20\n#endif",
          "#if defined(__apple_build_version__)\n/* XCODE26_FMT_FORCE_NO_CONSTEVAL */\n#  undef FMT_USE_CONSTEVAL\n#  define FMT_USE_CONSTEVAL 0\n#endif\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval\n#  define FMT_CONSTEXPR20 constexpr\n#else\n#  define FMT_CONSTEVAL\n#  define FMT_CONSTEXPR20\n#endif",
        )
      end

      File.write(fmt_base, content)
    end
  end
end
